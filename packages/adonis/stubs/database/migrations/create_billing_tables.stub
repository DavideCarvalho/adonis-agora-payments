import { BaseSchema } from '@adonisjs/lucid/schema'
import { createBillingTables, dropBillingTables } from '@adonis-agora/payments'

/**
 * The billing tables, for an app that would rather run DDL explicitly than have the library
 * do it.
 *
 * **You may not need this file.** `@adonis-agora/payments` creates its own tables on first
 * use, the same way `@adonis-agora/durable` and `@adonis-agora/authz` do — that is the
 * ecosystem convention, and it is on by default. This migration exists for the case where
 * that is not wanted: a shared database you do not own, a team that reviews every DDL, a
 * deploy that runs migrations as a separate step.
 *
 * If you keep it, turn the automatic path off so there is one owner:
 *
 *     // config/payments.ts
 *     billing: { autoCreateSchema: false }
 *
 * Leaving both on is harmless — the DDL is idempotent, so whichever runs second does
 * nothing — but "who creates this table" should have one answer.
 *
 * Both paths call the SAME `createBillingTables`, which is the point: a schema defined twice
 * is a schema that drifts, and this package spent a release finding the consequences of two
 * things that were supposed to agree and did not.
 *
 * `this.defer` is how a Lucid migration hands over the query client. Note that
 * `createBillingTables` only CREATES: a column added to the library after you run this
 * reaches your database through a migration you write, exactly as it would for any other
 * dependency.
 */
export default class extends BaseSchema {
  async up() {
    this.defer(async (db) => {
      await createBillingTables(db)
    })
  }

  async down() {
    this.defer(async (db) => {
      await dropBillingTables(db)
    })
  }
}
