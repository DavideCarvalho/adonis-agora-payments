import { defineConfig } from '@adonis-agora/payments/dashboard'

/**
 * Configuration for the @adonis-agora/payments dashboard.
 *
 * Without \`authorize\` the dashboard is open OUTSIDE production and answers
 * every request with 403 in production (a warning is logged at boot). Set
 * \`authorize\` to choose who may open it: an inline function,
 * an authorizer class (\`@inject()\` works), or a lazy import of one
 * (\`() => import('#policies/console_access')\`). It answers \`true\`/\`false\`,
 * \`{ allowed, reason?: 'unauthenticated' | 'forbidden' }\` or \`{ redirectTo }\`:
 * \`unauthenticated\` is a 401, any other denial (or a throw) a 403. For machine
 * access use \`authorizeByToken({ token: env.get('CONSOLE_TOKEN') })\`.
 *
 * Set \`enabled: false\` to remove it entirely — no routes are registered at all.
 *
 * \`dashboardAuth\` is an ADDITIVE, optional session gate on top of \`authorize\` —
 * a signed cookie minted via a built-in login page (Mode B: \`login\`) and/or a
 * "open the console from your app" endpoint (Mode A: \`session\`). At least one
 * of the two is required when \`dashboardAuth\` is set.
 */
export default defineConfig({
  // enabled: true,
  // path: '/payments',
  // currency: 'BRL',
  // authorize: (ctx) => ctx.auth.user?.isAdmin === true,
  // dashboardAuth: {
  //   secret: env.get('PAYMENTS_DASHBOARD_SECRET'),
  //   ttl: '8h',
  //   // Mode B — standalone login page.
  //   login: async (username, password) => {
  //     if (username === 'admin' && password === env.get('PAYMENTS_DASHBOARD_PASSWORD')) {
  //       return { id: 'admin', name: 'Admin' }
  //     }
  //     return null
  //   },
  //   // Mode A — mint a session for an already-authenticated host request.
  //   // session: async (request) => (request.user?.isAdmin ? { id: request.user.id } : null),
  // },
})
