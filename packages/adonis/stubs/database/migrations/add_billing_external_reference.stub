import { BaseSchema } from '@adonisjs/lucid/schema'

/**
 * Two columns the first migration did not have, published as a SECOND file because
 * `create_billing_tables` has already run everywhere this package is installed.
 *
 * - `billing_payments.external_reference` — the app's OWN id for a charge, echoed back by the
 *   gateway. It is the key that ties a gateway confirmation to your row, and until now nothing
 *   stored it: the webhook carried it, the processor read it for diagnostics, and it was
 *   dropped. Indexed, because it is a lookup key on a table that grows with every charge.
 *
 * - `billing_webhook_events.normalized` — the normalized event a delivery carried. Without it
 *   the dashboard's retry had to rebuild the event by re-parsing the raw payload, which
 *   re-verifies a signature computed from headers the ledger never kept, so a retry answered
 *   `422` on Stripe, Adyen and every other gateway that signs its webhooks.
 *
 * Every step is guarded by `hasColumn`, because a FRESH install gets both files: the create
 * migration already declares these columns, so this one must find nothing to do and say so by
 * doing nothing — rather than failing the very first `migration:run` of a new app.
 *
 * Both columns are nullable and neither is backfilled: nothing can invent a reference a row
 * never stored, and nothing can normalize a payload without the driver that received it. Rows
 * written before this migration keep `null`, the payment lookup falls back to the gateway id,
 * and the dashboard's retry says plainly that the row predates the column.
 */
export default class extends BaseSchema {
  protected tableName = 'billing_payments'

  async up() {
    if (!(await this.schema.hasColumn('billing_payments', 'external_reference'))) {
      this.schema.alterTable('billing_payments', (table) => {
        table.string('external_reference').nullable()
        table.index(['external_reference'], 'billing_payments_external_reference_idx')
      })
    }

    if (!(await this.schema.hasColumn('billing_webhook_events', 'normalized'))) {
      this.schema.alterTable('billing_webhook_events', (table) => {
        table.jsonb('normalized').nullable()
      })
    }
  }

  async down() {
    if (await this.schema.hasColumn('billing_payments', 'external_reference')) {
      this.schema.alterTable('billing_payments', (table) => {
        table.dropIndex(['external_reference'], 'billing_payments_external_reference_idx')
        table.dropColumn('external_reference')
      })
    }

    if (await this.schema.hasColumn('billing_webhook_events', 'normalized')) {
      this.schema.alterTable('billing_webhook_events', (table) => {
        table.dropColumn('normalized')
      })
    }
  }
}
