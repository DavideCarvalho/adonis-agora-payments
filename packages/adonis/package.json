{
  "name": "@adonis-agora/payments",
  "version": "0.6.0",
  "description": "Billing library for AdonisJS — 18 payment gateways behind one driver contract, with a Cashier-style subscription billing layer: Billable mixin, Lucid stores, idempotent webhook processing and an optional Durable-backed dispatcher. Part of the Agora ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-agora-payments.git",
    "directory": "packages/adonis"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./services/main": {
      "types": "./dist/src/services/main.d.ts",
      "import": "./dist/src/services/main.js",
      "default": "./dist/src/services/main.js"
    },
    "./payments_provider": {
      "types": "./dist/providers/payments_provider.d.ts",
      "import": "./dist/providers/payments_provider.js",
      "default": "./dist/providers/payments_provider.js"
    },
    "./dashboard_provider": {
      "types": "./dist/providers/dashboard_provider.d.ts",
      "import": "./dist/providers/dashboard_provider.js",
      "default": "./dist/providers/dashboard_provider.js"
    },
    "./payments_client_provider": {
      "types": "./dist/providers/payments_client_provider.d.ts",
      "import": "./dist/providers/payments_client_provider.js",
      "default": "./dist/providers/payments_client_provider.js"
    },
    "./configure": {
      "types": "./dist/configure.d.ts",
      "import": "./dist/configure.js",
      "default": "./dist/configure.js"
    },
    "./commands": {
      "types": "./dist/commands/main.d.ts",
      "import": "./dist/commands/main.js",
      "default": "./dist/commands/main.js"
    },
    "./commands/*": {
      "types": "./dist/commands/*.d.ts",
      "import": "./dist/commands/*.js",
      "default": "./dist/commands/*.js"
    },
    "./hooks/webhook_handlers": {
      "types": "./dist/src/hooks/webhook_handlers.d.ts",
      "import": "./dist/src/hooks/webhook_handlers.js",
      "default": "./dist/src/hooks/webhook_handlers.js"
    },
    "./testing": {
      "types": "./dist/src/testing/index.d.ts",
      "import": "./dist/src/testing/index.js",
      "default": "./dist/src/testing/index.js"
    },
    "./telescope": {
      "types": "./dist/src/telescope/index.d.ts",
      "import": "./dist/src/telescope/index.js",
      "default": "./dist/src/telescope/index.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "import": "./dist/src/types.js",
      "default": "./dist/src/types.js"
    },
    "./dashboard": {
      "types": "./dist/src/dashboard/index.d.ts",
      "import": "./dist/src/dashboard/index.js",
      "default": "./dist/src/dashboard/index.js"
    },
    "./client": {
      "types": "./dist/src/client/index.d.ts",
      "import": "./dist/src/client/index.js",
      "default": "./dist/src/client/index.js"
    },
    "./drivers/*": {
      "types": "./dist/src/drivers/*.d.ts",
      "import": "./dist/src/drivers/*.js",
      "default": "./dist/src/drivers/*.js"
    },
    "./webhook_security": {
      "types": "./dist/src/webhook_security.d.ts",
      "import": "./dist/src/webhook_security.js",
      "default": "./dist/src/webhook_security.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run copy:stubs && pnpm run copy:spa",
    "copy:stubs": "mkdir -p dist/stubs/config dist/stubs/database/migrations dist/stubs/make/billable dist/stubs/make/webhook_handler && cp -r stubs/config/. dist/stubs/config/ && cp -r stubs/database/migrations/. dist/stubs/database/migrations/ && cp -r stubs/make/billable/. dist/stubs/make/billable/ && cp -r stubs/make/webhook_handler/. dist/stubs/make/webhook_handler/",
    "copy:spa": "mkdir -p dist/assets && rm -rf dist/assets/spa && cp -r ../dashboard/dist/spa dist/assets/spa",
    "prepack": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "peerDependencies": {
    "@adonis-agora/durable": ">=0.1.0 <1.0.0",
    "@adonisjs/core": "^7.3.0",
    "@adonisjs/lucid": "^22.4.0",
    "@woovi/node-sdk": "^1.0.0",
    "stripe": "^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0"
  },
  "peerDependenciesMeta": {
    "@adonis-agora/durable": {
      "optional": true
    },
    "@adonisjs/lucid": {
      "optional": true
    },
    "@woovi/node-sdk": {
      "optional": true
    },
    "stripe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adonis-agora/payments-dashboard": "workspace:*",
    "@adonisjs/assembler": "^8.5.0",
    "@adonisjs/core": "7.5.0",
    "@adonisjs/lucid": "^22.4.2",
    "@mdx-js/mdx": "^3.1.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@woovi/node-sdk": "^1.3.3",
    "luxon": "^3.7.2",
    "pg": "^8.23.0",
    "stripe": "^22.6.0",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "payments",
    "billing",
    "subscriptions",
    "stripe",
    "adyen",
    "paypal",
    "mollie",
    "razorpay",
    "square",
    "paddle",
    "lemonsqueezy",
    "polar",
    "dodo",
    "abacatepay",
    "asaas",
    "woovi",
    "openpix",
    "pagarme",
    "infinitepay",
    "pagbank",
    "pagseguro",
    "efi",
    "gerencianet",
    "mercadopago",
    "pix",
    "boleto",
    "dashboard",
    "agora"
  ]
}
