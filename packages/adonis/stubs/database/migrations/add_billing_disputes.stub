import { BaseSchema } from '@adonisjs/lucid/schema'

/**
 * `billing_disputes` — a whole table the first migration did not have, published as a THIRD
 * file for the same reason `add_billing_external_reference` is a second one:
 * `create_billing_tables` has already run in every install this package is in, so a table
 * declared only there would never reach any of them.
 *
 * What it is for: a chargeback has a clock. `evidence_due_by` arrived on a webhook, was
 * published once on the diagnostics bus, and was then gone — so "which disputes are open,
 * and which windows close this week" could only be answered by opening each gateway's own
 * dashboard. A window that closes unanswered loses the money by default rather than on the
 * merits.
 *
 * The whole thing is guarded by `hasTable`, because a FRESH install gets both files: the
 * create migration already declares this table, so this one must find nothing to do and say
 * so by doing nothing — rather than failing the very first `migration:run` of a new app.
 *
 * Nothing is backfilled, and nothing can be: a dispute that closed before this table existed
 * left no record anywhere in the app to reconstruct, and the gateway is the only place its
 * deadline was ever written. The table starts empty and fills from the next dispute webhook.
 */
export default class extends BaseSchema {
  protected tableName = 'billing_disputes'

  async up() {
    if (await this.schema.hasTable('billing_disputes')) return

    this.schema.createTable('billing_disputes', (table) => {
      table.uuid('id').primary()
      // The DISPUTE's own gateway id — the idempotency key, hence unique. Where a gateway
      // sends none, the processor synthesizes one from the payment; see `WebhookProcessor`.
      table.string('gateway_id').unique()
      // The disputed PAYMENT's gateway id — the join back to `billing_payments.gateway_id`,
      // and indexed for it: getting from a dispute to its charge is the first thing anyone does.
      table.string('payment_gateway_id')
      table.string('provider')
      table.string('status')
      table.string('reason').nullable()
      // Nullable, both: a pre-dispute alert (Stripe's early fraud warning) names a charge and
      // a fraud type and no money at all.
      table.bigInteger('amount').nullable()
      table.string('currency', 3).nullable()
      // Nullable because plenty of gateways send no deadline. `null` means "this gateway told
      // us nothing", never "no hurry" — the deadline check counts only rows that carry one.
      table.timestamp('evidence_due_by', { useTz: true }).nullable()
      table.string('outcome').nullable()
      table.timestamp('opened_at', { useTz: true }).nullable()
      table.timestamp('closed_at', { useTz: true }).nullable()
      table.jsonb('payload').nullable()
      table.timestamp('created_at', { useTz: true }).notNullable()
      table.timestamp('updated_at', { useTz: true }).notNullable()
      table.index(['payment_gateway_id'], 'billing_disputes_payment_idx')
      // The deadline query — open disputes ordered by the window that closes soonest — reads
      // exactly these two columns, in this order.
      table.index(['status', 'evidence_due_by'], 'billing_disputes_deadline_idx')
    })
  }

  async down() {
    // `IfExists`, and so is the create migration's: on a fresh install BOTH files know about
    // this table, rollback runs newest-first, and a plain `dropTable` in the second one to run
    // would fail on a table the first one already dropped.
    this.schema.dropTableIfExists('billing_disputes')
  }
}
